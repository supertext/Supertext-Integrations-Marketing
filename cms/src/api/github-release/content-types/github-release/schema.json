{
  "kind": "collectionType",
  "collectionName": "github_releases",
  "info": {
    "singularName": "github-release",
    "pluralName": "github-releases",
    "displayName": "GitHub release",
    "description": "Filled in automatically every night from GitHub (latest release, release and issue counts for the statistics page); don't edit."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "repo": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "version": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "releasedAt": {
      "type": "datetime"
    },
    "prerelease": {
      "type": "boolean",
      "default": false
    },
    "syncedAt": {
      "type": "datetime"
    },
    "releases30": {
      "type": "integer"
    },
    "releases90": {
      "type": "integer"
    },
    "issuesOpen": {
      "type": "integer"
    },
    "issuesClosed": {
      "type": "integer"
    },
    "closeHours": {
      "type": "json"
    },
    "issuesAutomated": {
      "type": "integer"
    }
  }
}
